# Copy to .env.local. These are the local dev server's values (see dev/livekit.yaml).
LIVEKIT_URL=ws://127.0.0.1:4070
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# -- The models ---------------------------------------------------------------------
# Each job names its model as provider:model. Left out or "off", the job is not done.
# With none set, classes are read from their scripts and chat is not answered.
# How it works, and every provider: agent/src/lecturer/settings.py. To see what is
# set and try each model once:  cd agent && uv run python -m lecturer.settings --try
#
# Keys. Put real ones in .env.local, never here. With a key, uncomment the jobs below
# that you want (all are off until then).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# A server of your own that speaks the OpenAI API (Ollama, LM Studio, vLLM ...):
# CH_PROVIDER_LOCAL_URL=http://localhost:11434/v1
#
# A live class (written as it is taught):
# CH_WRITER=anthropic:claude-sonnet-5-5
#   Reshapes the rest of the class at checkpoints. Optional.
# CH_PLANNER=anthropic:claude-sonnet-5-5
#   Sorts chat messages quickly. Optional: without it the teacher sees every message.
#   Made for decision models, e.g. CH_DECISIONS=openrouter:<decision model>
# CH_DECISIONS=anthropic:claude-haiku-5-5
#
# A class read from its script: chat questions answered on the side.
# CH_QUESTIONS=anthropic:claude-haiku-5-5
# CH_ANSWERS=anthropic:claude-sonnet-5-5
#
# Anything a service has that is not general goes in CH_<JOB>_EXTRA, as JSON laid over
# every request for that job:
# CH_DECISIONS_EXTRA={"reasoning": {"enabled": false}}
#
# CH_LIVE=1         every class is taught live. (In development, a room whose name
#                   starts with live- is taught live without this.)

# Pictures made during a class, when the lecturer asks for one. An image model, so
# not anthropic. Optional: without it, a lesson goes on without the made pictures.
# CH_IMAGES=openai:<image model>
# CH_IMAGES_STYLE=A clear, simple picture for teaching, on a plain light background.
# CH_IMAGES_LIMIT=12   the most pictures one class may make. Not set: no limit. If
#                      each picture costs money, setting one is recommended.
# CH_IMAGES_EXTRA={"size": "1024x1024"}

# Hearing what people say aloud: a model that takes audio in, for example
# CH_HEARING=openrouter:google/gemini-3.8-flash. Optional: without it the lecturer
# stops while people talk, but cannot tell what they said (agent/src/lecturer/speech/hearing.py).
# -- The voice ----------------------------------------------------------------------
# Not set: no voice. The class is in captions only, each sentence taking about as
# long as it would take to say.
# CH_TTS=<module>:<Class>   any LiveKit text-to-speech class, with CH_TTS_OPTIONS as
#                   JSON. See agent/src/lecturer/speech/tts/__init__.py
# CH_TTS=mac        on a Mac, its `say` command (CH_MAC_VOICE=Samantha): a stand-in
#                   for trying things out.

# -- Other ----------------------------------------------------------------------------
# CH_<JOB>_LIMIT=   the most calls one lecturer may make to that job's model in a class,
#                   e.g. CH_DECISIONS_LIMIT=800. Not set: no limit. When a class splits,
#                   each group's lecturer has limits of its own. Past CH_WRITER_LIMIT
#                   the rest of a live class is read from its script.
# CH_MAX_CLASSES=8  lecturers one process runs at once: one for each class, and one
#                   for each of its groups when it splits
# CH_PROMPTS_DIR=   a folder of your own prompts (writer.md, planner.md). Any it has
#                   are used instead of ours, which are one way to teach, not the
#                   only one (agent/src/lecturer/teaching/prompts/).
# CH_STUDENT_NAMES=names   how the live teacher's models know students: by the name each
#                   gave, with a label (names, the default: the teacher may use names
#                   in class), or by label only (labels: s1, s2, and nobody is named)
# CH_SPLIT_HELPERS=1  human helpers needed for each group when the class splits.
#                   1 is recommended; 0 lets a class split with nobody supervising.
# CH_RECORD_CLASS=1 for testing a live class: writes everything the teacher saw and
#                   did, students' words included, to logs/recorded/. Only with the
#                   students' agreement. Simulated classes can be built from it.
# CH_CHROME=        the Chrome or Chromium for the shared screen (a lesson's `open:`
#                   steps), if it is not on the PATH
# CH_LESSONS_DIR=   where lessons are, as a full path (see lessons/README.md)
# CH_GENERATED_DIR= where made pictures are kept, if not generated/. The web app
#                   serves them, so set the same in web/.env.local.
