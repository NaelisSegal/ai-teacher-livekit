# Copy to .env.local. These are the local dev server's values (see dev/livekit.yaml).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:4070

# Codes that let someone join as a human helper or a guest lecturer:
#   /class/<room>?as=helper&code=<code>
# These are dev values. Use long random ones on a real server.
CH_HELPER_CODE=dev-helper
CH_GUEST_CODE=dev-guest

# Development only. Lets any room name be opened, with the lesson chosen by the link,
# and uses lessons/schedule.dev.json as the schedule if there is one. Leave it out on a
# real server: then a room can be joined only if lessons/schedule.json has it and it is
# open now.
CH_OPEN_ROOMS=1

# On a real server: how many of your own proxies sit in front of the web app, so that
# the join limit can tell senders apart.
# CH_PROXY_HOPS=1

# Where lessons are, as a full path, if not lessons/ (see lessons/README.md).
# CH_LESSONS_DIR=

# Where the lecturer keeps pictures made during a class, if not generated/. The same
# as in agent/.env.local.
# CH_GENERATED_DIR=

# The AI services that chat may be sent to, named on the join screen. It depends on
# the models the lecturer is set up with (agent/.env.local).
# CH_AI_SERVICES=Anthropic

# What this deployment is called, in page titles and the class page's header.
# NEXT_PUBLIC_SITE_NAME=Curiosity Hall
